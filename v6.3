-- CONFIG TAB

-- ApplyConfigData is defined below after all UI widget refs are created

-- [[ CONFIG SYSTEM ]]
-- Folder stored in %appdata%\73829100\ (hidden from casual users)
-- File names are XOR-encrypted with a key so they look like gibberish on disk
-- The real (decrypted) name is what the user types — shown in the UI

local CONFIG_FOLDER = (function()
-- Get %appdata% path via Velocity's getspecialfolders or fallback methods
local appdata = nil
pcall(function()
-- Velocity exposes this
appdata = getspecialfolders and getspecialfolders().appdata
end)
pcall(function()
if not appdata then
-- Synapse / general fallback via readfile on a known path
appdata = getspecialfolders and getspecialfolders().RoamingAppData
end
end)
pcall(function()
if not appdata then
-- Try querying environment via Velocity's executor env
appdata = getenv and getenv("APPDATA")
end
end)
if appdata then
return appdata .. "\\73829100"
end
-- Last resort fallback: executor workspace subfolder
return "73829100"
end)()
local CONFIG_KEY = 0x4A -- single-byte XOR key for filename encryption

-- XOR encrypt/decrypt a string (same operation both ways)
local function XORString(str)
local result = {}
for i = 1, #str do
result[i] = string.char(bit32.bxor(string.byte(str, i), CONFIG_KEY))
end
return table.concat(result)
end

-- Convert string to hex so the filename is printable on disk
local function ToHex(str)
local hex = {}
for i = 1, #str do
hex[i] = string.format("%02x", string.byte(str, i))
end
return table.concat(hex)
end

-- Convert hex back to string
local function FromHex(hex)
local str = {}
for i = 1, #hex, 2 do
str[#str + 1] = string.char(tonumber(hex:sub(i, i + 1), 16))
end
return table.concat(str)
end

-- Encrypt a display name → disk filename (e.g. "myconfig" → "3c2b1e...")
local function EncryptName(displayName)
return ToHex(XORString(displayName)) .. ".json"
end

-- Decrypt a disk filename → display name (e.g. "3c2b1e....json" → "myconfig")
local function DecryptName(fileName)
local hex = fileName:gsub("%.json$", "")
local ok, result = pcall(function() return XORString(FromHex(hex)) end)
return ok and result or fileName -- fallback to raw name if corrupt
end

local function EnsureFolder()
pcall(function()
if not isfolder(CONFIG_FOLDER) then
makefolder(CONFIG_FOLDER)
end
end)
end

