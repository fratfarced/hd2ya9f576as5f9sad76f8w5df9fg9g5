-- Check if the real leg is still connected to the character (shouldn't be, but handle edge cases)
local function IsLegAttached(leg, torso)
if not leg or not torso then return false end
-- Iterate through all children of the torso that are JointInstances and connected to this leg
for _, child in pairs(torso:GetChildren()) do
if child:IsA("JointInstance") and child.Part1 == leg then
return true
end
end
-- Also check the leg itself for any joints pointing to it (unlikely but safe)
for _, child in pairs(leg:GetChildren()) do
if child:IsA("JointInstance") and child.Part1 == leg then
return true
end
end
return false
end

local function CleanupReachDecoy(player)
local data = ReachDecoys[player]
if not data then return end
ReachDecoys[player] = nil -- remove entry FIRST

-- Destroy fake leg and any attached motor
pcall(function()
if data.fakeLeg and data.fakeLeg.Parent then
local char = data.fakeLeg.Parent
local torso = char:FindFirstChild("Torso")
if torso then
local fakeHip = torso:FindFirstChild("Right Hip")
if fakeHip and fakeHip.Part1 == data.fakeLeg then
fakeHip:Destroy()
end
end
data.fakeLeg:Destroy()
end
end)

-- Restore the real leg – even if something fails, force unanchor
pcall(function()
local realLeg = data.realLeg
if realLeg and realLeg.Parent then
-- Break all joints again to kill any residual connections
realLeg:BreakJoints()

local char = realLeg.Parent
local torso = char:FindFirstChild("Torso")

-- Remove any stray hip motor that isn’t ours
if torso then
local strayHip = torso:FindFirstChild("Right Hip")
if strayHip and strayHip.Part1 ~= realLeg then
strayHip:Destroy()
end
end

realLeg.Name = "Right Leg"
realLeg.Transparency = data.originalTransparency or 0
realLeg.CanCollide = data.originalCanCollide ~= false
realLeg.Velocity = Vector3.zero
realLeg.RotVelocity = Vector3.zero

-- Recreate the original motor if possible
if data.motorData and data.motorData.Part0 and data.motorData.Part0.Parent then
local motor = Instance.new("Motor6D")
motor.Name = "Right Hip"
motor.Part0 = data.motorData.Part0
motor.Part1 = realLeg
motor.C0 = data.motorData.C0
motor.C1 = data.motorData.C1
motor.Parent = data.motorData.Part0
realLeg.Anchored = false
realLeg.CFrame = data.motorData.Part0.CFrame * data.motorData.C0 * data.motorData.C1:Inverse()
else
-- No motor data – just unanchor the leg (it will fall, but won't drag the player)
realLeg.Anchored = false
end
end
end)
end

local function CleanupAllReachDecoys()
for player, _ in pairs(ReachDecoys) do
CleanupReachDecoy(player)
end
end

local function SetupReachDecoy(targetPlayer, targetCharacter, realLeg)
if ReachDecoys[targetPlayer] then return end

local torso = targetCharacter:FindFirstChild("Torso")
if not torso or not realLeg or not realLeg.Parent then return end

local motor = torso:FindFirstChild("Right Hip")
if motor and motor.Part1 ~= realLeg then
motor = realLeg:FindFirstChild("Right Hip")
end

local motorData = nil
if motor and motor:IsA("Motor6D") then
motorData = {
Part0 = motor.Part0,
C0 = motor.C0,
C1 = motor.C1,
}
motor:Destroy()
end

local originalTransparency = realLeg.Transparency
local originalCanCollide = realLeg.CanCollide
local originalAnchored = realLeg.Anchored
local legSize = realLeg.Size
local legColor = realLeg.Color
local legMaterial = realLeg.Material

realLeg.Name = REAL_LEG_NAME
realLeg:BreakJoints()
realLeg.Transparency = 1
realLeg.CanCollide = true
realLeg.Anchored = true

local fakeLeg = Instance.new("Part")
fakeLeg.Name = "Right Leg"
fakeLeg.Size = legSize
fakeLeg.CanCollide = false
fakeLeg.Massless = true
fakeLeg.Anchored = false
fakeLeg.Color = legColor
fakeLeg.Material = legMaterial
fakeLeg.Parent = targetCharacter

local footAttach = Instance.new("Attachment")
footAttach.Name = "RightFootAttachment"
footAttach.Position = Vector3.new(0, -legSize.Y / 2, 0)
footAttach.Parent = fakeLeg

if motorData and motorData.Part0 and motorData.Part0.Parent then
local fakeMotor = Instance.new("Motor6D")
fakeMotor.Name = "Right Hip"
fakeMotor.Part0 = motorData.Part0
fakeMotor.Part1 = fakeLeg
fakeMotor.C0 = motorData.C0
fakeMotor.C1 = motorData.C1
fakeMotor.Parent = motorData.Part0
fakeLeg.CFrame = motorData.Part0.CFrame * motorData.C0 * motorData.C1:Inverse()
else
local weld = Instance.new("Weld")
weld.Name = "Avelune_FakeLegWeld"
weld.Part0 = torso
weld.Part1 = fakeLeg
weld.C0 = CFrame.new(0.5, -1, 0)
weld.C1 = CFrame.new(0, 0, 0)
weld.Parent = torso
end

ReachDecoys[targetPlayer] = {
realLeg = realLeg,
fakeLeg = fakeLeg,
motorData = motorData,
originalTransparency = originalTransparency,
originalCanCollide = originalCanCollide,
originalAnchored = originalAnchored,
}
end

local function UpdateReachDecoyPosition(targetPlayer, humanoidRootPart)
local data = ReachDecoys[targetPlayer]
if not data then return end

if not data.realLeg or not data.realLeg.Parent then
ReachDecoys[targetPlayer] = nil
return
end

-- Safety: if the target suddenly left range, force cleanup immediately
local targetCharacter = targetPlayer.Character
local targetHRP = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
if targetHRP then
local distance = (humanoidRootPart.Position - targetHRP.Position).Magnitude
if distance > ReachSize then
CleanupReachDecoy(targetPlayer)
return
end
else
-- Character died / HRP missing – clean up
CleanupReachDecoy(targetPlayer)
return
end

-- FINAL FIX: If the leg somehow reattached (joint exists), break it right here to stop dragging
if IsLegAttached(data.realLeg, targetCharacter:FindFirstChild("Torso")) then
data.realLeg:BreakJoints()
data.realLeg.Anchored = true
-- Still update its position, but now it's detached again
end

data.realLeg.CFrame = humanoidRootPart.CFrame * CFrame.new(1, 0, -3.5)
end

