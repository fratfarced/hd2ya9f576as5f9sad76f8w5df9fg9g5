local function RefreshConfigDropdown()
local list = GetConfigList()
local names = {}
for _, entry in ipairs(list) do
table.insert(names, entry.display)
end
if #names == 0 then
names = { "No configs found" }
SelectedConfigEntry = nil
end
pcall(function() ConfigDropdown:SetValues(names) end)
-- Also refresh the list label below
RefreshConfigListLabel()
end

