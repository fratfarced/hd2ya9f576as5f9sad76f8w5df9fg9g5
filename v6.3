end
local parsed, parseErr = pcall(function()
ApplyConfigData(HttpService:JSONDecode(result))
end)
if parsed then
SetCurrentConfig(SelectedConfigEntry.display)
if NotificationsEnabled then
Fluent:Notify({ Title = "Config Loaded", Content = "\"" .. SelectedConfigEntry.display .. "\" loaded.", Duration = 3 })
end
else
