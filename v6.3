-- Read all configs from folder and return list of {display, file} pairs
local function GetConfigList()
local list = {}
pcall(function()
EnsureFolder()
local files = listfiles(CONFIG_FOLDER)
for _, path in ipairs(files) do
local fileName = path:match("([^/\\]+)$") -- basename
if fileName and fileName:match("%.json$") then
local display = DecryptName(fileName)
table.insert(list, { display = display, file = fileName })
end
end
end)
return list
end

-- State
local CurrentConfigName = "none"
local ConfigNameInput = ""

-- UI paragraphs we need to update
local CurrentConfigLabel
local ConfigListLabel

local function RefreshConfigListLabel()
local list = GetConfigList()
if #list == 0 then
pcall(function() ConfigListLabel:SetDesc("No configs saved yet.") end)
return
end
local lines = {}
for _, entry in ipairs(list) do
table.insert(lines, entry.display .. " → " .. entry.file)
end
pcall(function() ConfigListLabel:SetDesc(table.concat(lines, "\n")) end)
end

local function SetCurrentConfig(name)
CurrentConfigName = name
pcall(function() CurrentConfigLabel:SetDesc(name) end)
end

