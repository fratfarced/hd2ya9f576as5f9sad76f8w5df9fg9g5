-- Main RenderLoop
RunService.RenderStepped:Connect(function()
local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
local originPos = (AimMethod == "Mouse") and UserInputService:GetMouseLocation() or Center

if ShowFOV and AimAssistEnabled and IsLocalAlive() then
FOVCircle.Position = originPos
FOVCircle.Radius = FOVRadius
FOVCircle.Visible = true
else
FOVCircle.Visible = false
end

if ShowReachIndicator and ReachEnabled and IsLocalAlive() then
local character = LocalPlayer.Character
local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")

if humanoidRootPart then
if #ReachCircleParts == 0 then
createReachCircle()
end

if #ReachCircleParts > 0 then
updateReachCirclePosition(humanoidRootPart.Position)
end

local sword = character:FindFirstChildOfClass("Tool")
local enemyInRange = false

if sword and sword:FindFirstChild("Handle") then
for _, targetPlayer in pairs(Players:GetPlayers()) do
if targetPlayer ~= LocalPlayer and not getgenv().WhitelistedPlayers[targetPlayer.Name] then
if targetPlayer.Character then
local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
if targetHRP then
local distance = (humanoidRootPart.Position - targetHRP.Position).Magnitude
if distance <= ReachSize then
enemyInRange = true
break
end
end
end
end
end
end

RainbowOffset = RainbowOffset + 0.01
if RainbowOffset > 1 then RainbowOffset = 0 end

if enemyInRange then
setReachCircleColor(ReachColorActive, RainbowActive)
else
setReachCircleColor(ReachColorNormal, RainbowNormal)
end
else
destroyReachCircle()
end
else
destroyReachCircle()
end

if AimAssistEnabled and IsLocalAlive() then

local target = FindBestTarget()

if target then
local finalTargetPos = GetPredictedPosition(target)
if finalTargetPos then
if AimMethod == "Camera" then
Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, finalTargetPos), AimSmoothness)
elseif AimMethod == "Mouse" then
local screenPos = Camera:WorldToViewportPoint(finalTargetPos)
local mPos = UserInputService:GetMouseLocation()
mousemoverel((screenPos.X - mPos.X) * AimSmoothness, (screenPos.Y - mPos.Y) * AimSmoothness)
end
-- Silent Aim: no per-frame movement, only activates on bow fire via hook
end
end
else
-- Aim assist off — clear lock so bow falls back to real mouse
LockedTarget = nil
end
end)

