Tabs.Config:AddButton({
Title = "Save Config",
Description = "Saves current settings to an encrypted file",
Callback = function()
local name = ConfigNameInput
if not name or name == "" then
Fluent:Notify({ Title = "Config", Content = "Enter a config name first.", Duration = 3 })
return
end

EnsureFolder()
local fileName = EncryptName(name)
local filePath = CONFIG_FOLDER .. "\\" .. fileName
local data = GetConfigData()

-- Pretty-print manually so the file is human-readable
local function indent(n) return string.rep(" ", n) end
local function encodeValue(v)
if type(v) == "boolean" then return tostring(v)
elseif type(v) == "number" then return tostring(v)
elseif type(v) == "string" then return '"' .. v:gsub('"', '\\"') .. '"'
else return '"?"' end
end
local lines = {"{"}
local sections = {"Reach","Combat","AimAssist","Prediction","AutoClicker","UI"}
for si, section in ipairs(sections) do
local block = data[section]
if block then
table.insert(lines, indent(1) .. '"' .. section .. '": {')
local keys = {}
for k in pairs(block) do table.insert(keys, k) end
table.sort(keys)
for ki, k in ipairs(keys) do
local comma = (ki < #keys) and "," or ""
table.insert(lines, indent(2) .. '"' .. k .. '": ' .. encodeValue(block[k]) .. comma)
end
local sectionComma = (si < #sections) and "," or ""
table.insert(lines, indent(1) .. "}" .. sectionComma)
end
end
table.insert(lines, "}")
local jsonStr = table.concat(lines, "\n")

local ok, err = pcall(function()
writefile(filePath, jsonStr)
end)

if ok then
SetCurrentConfig(name)
RefreshConfigDropdown()
if NotificationsEnabled then
