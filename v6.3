-- ============================================================
-- [[ RAKNET DESYNC ]] – replaces the old velocity‑based method
-- ============================================================
local RakNetHookAdded = false
local function SetupRakNetDesync()
if RakNetHookAdded then return end
if not raknet or not raknet.add_send_hook then
print("RakNet not available – Desync will be inactive.")
-- Optionally disable the toggle so the user knows
if ToggleDesync then
pcall(function() ToggleDesync:SetValue(false) end)
DesyncActive = false
end
return
end
raknet.add_send_hook(function(packet)
if DesyncActive and packet.PacketId == 0x1B then
local buf = packet.AsBuffer
-- Corrupt the movement data by writing 0xFFFFFFFF at offset 1
buffer.writeu32(buf, 1, 0xFFFFFFFF)
packet:SetData(buf)
end
end)
RakNetHookAdded = true
print("RakNet desync hook installed.")
end

-- Call this once after everything is set up
SetupRakNetDesync()
