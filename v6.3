-- R6 parts used for Closest Part mode
local R6Parts = { "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }

-- Returns the character part closest to the FOV origin (screen position)
local function GetClosestPart(character, originPos)
local bestPart = nil
local bestDist = math.huge
for _, partName in ipairs(R6Parts) do
local part = character:FindFirstChild(partName)
if part then
local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
if onScreen then
local dist = (Vector2.new(pos.X, pos.Y) - originPos).Magnitude
if dist < bestDist then
bestDist = dist
bestPart = part
end
end
end
end
return bestPart
end

-- Returns the world position of the aim part for a player, respecting Closest Part mode
local function GetAimPartPosition(player, originPos)
if not player.Character then return nil end
if AimPart == "Closest Part" then
local part = GetClosestPart(player.Character, originPos)
return part and part.Position or nil
else
local part = player.Character:FindFirstChild(AimPart)
return part and part.Position or nil
end
end

-- Helper Functions
local function IsValid(plr)
if not plr or not plr.Character or not plr.Character:FindFirstChild("Humanoid") then
return false
end
local isAlive = plr.Character.Humanoid.Health > 0
local isNotWhitelisted = not getgenv().WhitelistedPlayers[plr.Name]
if not isAlive or not isNotWhitelisted then return false end
-- For Closest Part, just need any R6 part to exist
if AimPart == "Closest Part" then
return plr.Character:FindFirstChild("Torso") ~= nil
end
return plr.Character:FindFirstChild(AimPart) ~= nil
end

local function IsLocalAlive()
return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character.Humanoid.Health > 0
end

-- [[ TARGET LOCKING ]]
-- Single source of truth for both RenderStepped and bow hook.
-- Behaviour:
-- StickyAim ON → keep locked target until they leave FOV, then find new closest
-- StickyAim OFF → always return closest to FOV center this frame, no persistence
-- Silent Aim → FOV radius ignored, scans full screen
-- No players in FOV → returns nil, callers fall back to real mouse
local function FindBestTarget()
if not IsLocalAlive() then
LockedTarget = nil
return nil
end

local originPos
if AimMethod == "Mouse" then
originPos = UserInputService:GetMouseLocation()
else
originPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

-- All methods respect FOV radius for target selection.
-- Silent Aim just means no camera/mouse movement on fire, not unlimited range.
local maxDist = FOVRadius

-- StickyAim ON: if we have a lock check if it's still valid and inside FOV
if StickyAim and LockedTarget then
if IsValid(LockedTarget) then
local worldPos = GetAimPartPosition(LockedTarget, originPos)
if worldPos then
local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
local dist = (Vector2.new(screenPos.X, screenPos.Y) - originPos).Magnitude
if onScreen and dist <= FOVRadius then
return LockedTarget -- still in FOV, keep lock
end
end
end
-- Left FOV or died → drop lock and fall through to rescan
LockedTarget = nil
end

-- Scan all players, find closest to FOV origin within maxDist
local bestTarget = nil
local bestDist = maxDist
for _, player in pairs(Players:GetPlayers()) do
if player ~= LocalPlayer and IsValid(player) then
local worldPos = GetAimPartPosition(player, originPos)
if worldPos then
local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
if onScreen then
local dist = (Vector2.new(screenPos.X, screenPos.Y) - originPos).Magnitude
if dist < bestDist then
bestDist = dist
bestTarget = player
end
end
end
end
end

-- StickyAim ON → store lock (nil if nobody in FOV, which is intentional)
-- StickyAim OFF → never touch LockedTarget, re-evaluate fresh every frame
if StickyAim then
LockedTarget = bestTarget
end

return bestTarget -- nil = nobody in FOV, caller shoots at real mouse
end

-- Build the predicted world position for a target using shared prediction settings
local function GetPredictedPosition(target)
local originPos = (AimMethod == "Mouse") and UserInputService:GetMouseLocation()
or Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
local worldPos = GetAimPartPosition(target, originPos)
if not worldPos then return nil end
if PredictionEnabled then
-- Get the actual part for velocity
local part
if AimPart == "Closest Part" then
part = GetClosestPart(target.Character, originPos)
else
part = target.Character:FindFirstChild(AimPart)
end
if part then
local vel = part.Velocity
worldPos = worldPos + Vector3.new(vel.X * PredictionX, vel.Y * PredictionY, vel.Z * PredictionX)
end
end
return worldPos
end

local function HookBowSilentAim(tool)
-- Wait for ClientControl to fully replicate, not just 0.1s guess
local clientControl = tool:FindFirstChild("ClientControl")
if not clientControl then
clientControl = tool.ChildAdded:Wait()
-- Make sure we actually got ClientControl and not some other child
if clientControl.Name ~= "ClientControl" then
clientControl = tool:WaitForChild("ClientControl", 5)
end
end
if not clientControl then return end

clientControl.OnClientInvoke = function()
if not IsLocalAlive() or not AimAssistEnabled then
return LocalPlayer:GetMouse().Hit.p
end

local target = FindBestTarget()
if not target then
return LocalPlayer:GetMouse().Hit.p
end

local finalPos = GetPredictedPosition(target)
if not finalPos then
return LocalPlayer:GetMouse().Hit.p
end

-- Snap camera/mouse based on method
if AimMethod == "Camera" then
Camera.CFrame = CFrame.new(Camera.CFrame.Position, finalPos)
elseif AimMethod == "Mouse" then
local screenPos = Camera:WorldToViewportPoint(finalPos)
local mPos = UserInputService:GetMouseLocation()
pcall(function()
mousemoverel(screenPos.X - mPos.X, screenPos.Y - mPos.Y)
end)
end
-- Silent Aim: no camera/mouse movement, position goes silently to server only

return finalPos
end
end

