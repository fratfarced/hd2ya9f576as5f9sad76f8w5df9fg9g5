Tabs.ChatLogger:AddParagraph({
    Title = "Server Chat Log",
    Content = "Last 100 messages will appear below as players chat"
})

local ChatMessages = {}
local MaxMessages = 100

local function LogMessage(msg, author)
    local messageText = "[" .. author .. "]: " .. msg
    table.insert(ChatMessages, 1, messageText)
    
    if #ChatMessages > MaxMessages then
        table.remove(ChatMessages, #ChatMessages)
    end
    
    local allMessages = table.concat(ChatMessages, "\n")
    
    if not Tabs.ChatLogger.ChatDisplay then
        Tabs.ChatLogger.ChatDisplay = Tabs.ChatLogger:AddParagraph({
            Title = "Recent Messages",
            Content = allMessages
        })
    else
        pcall(function()
            Tabs.ChatLogger.ChatDisplay:SetDesc(allMessages)
        end)
    end
end

for _, player in pairs(Players:GetPlayers()) do
    player.Chatted:Connect(function(msg) LogMessage(msg, player.Name) end)
end
Players.PlayerAdded:Connect(function(player)
    player.Chatted:Connect(function(msg) LogMessage(msg, player.Name) end)
end)

