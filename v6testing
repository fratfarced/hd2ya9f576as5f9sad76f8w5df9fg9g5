-- Detect executor type (Internal vs External)
local function detectExecutorType()
    -- Internal executors typically have Drawing and mouse APIs
    local hasInternalApis = false
    pcall(function()
        local testCircle = Drawing.new("Circle")
        if testCircle then hasInternalApis = true end
    end)
    
    -- External executors (like Xeno) typically lack these
    if Executor.Name == "Xeno" then
        return "External"
    elseif hasInternalApis then
        return "Internal"
    else
        -- Try to detect via other means
        pcall(function()
            mouse1click()
            hasInternalApis = true
        end)
        return hasInternalApis and "Internal" or "External"
    end
end

