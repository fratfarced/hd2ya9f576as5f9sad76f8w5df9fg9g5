-- [[ CLONE & SWAP REACH FUNCTION ]]
local function performCloneSwap(targetPlayer, targetHRP, humanoidRootPart)
    if not targetPlayer or not targetPlayer.Character then return end
    if SwappedLegs[targetPlayer] then return end -- Already swapped this player
    
    local targetCharacter = targetPlayer.Character
    local targetLeg = targetCharacter:FindFirstChild("Right Leg")
    
    if not targetLeg then 
        -- Try Left Leg as fallback
        targetLeg = targetCharacter:FindFirstChild("Left Leg")
    end
    
    if not targetLeg then return end
    
    -- Create the Fake Leg (perfect clone)
    local fakeLeg = targetLeg:Clone()
    fakeLeg.Name = "FakeLeg"
    fakeLeg.Parent = targetCharacter
    
    -- Position fake leg exactly where real leg was
    fakeLeg.CFrame = targetLeg.CFrame
    fakeLeg.Velocity = Vector3.new(0, 0, 0)
    fakeLeg.RotVelocity = Vector3.new(0, 0, 0)
    
    -- Find the Motor6D joint connecting the leg to the torso
    local motor = nil
    for _, joint in pairs(targetCharacter:GetDescendants()) do
        if joint:IsA("Motor6D") then
            if joint.Part1 == targetLeg then
                motor = joint
                break
            end
        end
    end
    
    if motor then
        -- Redirect the joint to point to the fake leg instead
        motor.Part1 = fakeLeg
    else
        -- No motor found, just position the fake leg and keep it anchored
        fakeLeg.Anchored = true
    end
    
    -- Now teleport the REAL leg to the player's feet (invisible, for hit registration)
    local realLeg = targetLeg
    realLeg:BreakJoints()
    realLeg.Transparency = 1
    realLeg.CanCollide = false
    realLeg.Anchored = true
    realLeg.Massless = true
    realLeg.CFrame = humanoidRootPart.CFrame * CFrame.new(1, 0, -3.5)
    
    -- Store the swap data
    SwappedLegs[targetPlayer] = {
        FakeLeg = fakeLeg,
        RealLeg = realLeg,
        Swapped = true
    }
end

-- Main RenderLoop
RunService.RenderStepped:Connect(function()
    local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local originPos = (AimMethod == "Mouse") and UserInputService:GetMouseLocation() or Center
    
    if ShowFOV and AimAssistEnabled and IsLocalAlive() and FOVCircle then
        FOVCircle.Position = originPos
        FOVCircle.Radius = FOVRadius
        FOVCircle.Visible = true
    elseif FOVCircle then
        FOVCircle.Visible = false
    end
    
    if ShowReachIndicator and ReachEnabled and IsLocalAlive() then
        local character = LocalPlayer.Character
        local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
        
        if humanoidRootPart then
            if #ReachCircleParts == 0 then
                createReachCircle()
            end
            
            if #ReachCircleParts > 0 then
                updateReachCirclePosition(humanoidRootPart.Position)
            end
            
            local sword = character:FindFirstChildOfClass("Tool")
            local enemyInRange = false
            
            if sword and sword:FindFirstChild("Handle") then
                for _, targetPlayer in pairs(Players:GetPlayers()) do
                    if targetPlayer ~= LocalPlayer and not getgenv().WhitelistedPlayers[targetPlayer.Name] then
                        if targetPlayer.Character then
                            local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if targetHRP then
                                local distance = (humanoidRootPart.Position - targetHRP.Position).Magnitude
                                if distance <= ReachSize then
                                    enemyInRange = true
                                    break
                                end
                            end
                        end
                    end
                end
            end
            
            RainbowOffset = RainbowOffset + 0.01
            if RainbowOffset > 1 then RainbowOffset = 0 end
            
            if enemyInRange then
                setReachCircleColor(ReachColorActive, RainbowActive)
            else
                setReachCircleColor(ReachColorNormal, RainbowNormal)
            end
        else
            destroyReachCircle()
        end
    else
        destroyReachCircle()
    end

    if AimAssistEnabled and IsLocalAlive() then
        local target = nil

        if StickyAim and LockedTarget and IsValid(LockedTarget) then
            local pos, onScreen = Camera:WorldToViewportPoint(LockedTarget.Character[AimPart].Position)
            local dist = (Vector2.new(pos.X, pos.Y) - originPos).Magnitude
            if onScreen and dist <= FOVRadius then
                target = LockedTarget
            end
        end

        if not target then
            local lastDist = FOVRadius
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and IsValid(player) then
                    local pos, onScreen = Camera:WorldToViewportPoint(player.Character[AimPart].Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - originPos).Magnitude
                        if dist < lastDist then
                            lastDist = dist
                            target = player
                            if StickyAim then LockedTarget = player end
                        end
                    end
                end
            end
        end

        if target then
            local targetPart = target.Character[AimPart]
            local finalTargetPos = targetPart.Position
            
            if PredictionEnabled then
                local vel = targetPart.Velocity
                finalTargetPos = finalTargetPos + Vector3.new(vel.X * PredictionX, vel.Y * PredictionY, vel.Z * PredictionX)
            end

            if AimMethod == "Camera" then
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, finalTargetPos), AimSmoothness)
            elseif AimMethod == "Mouse" and Executor.HasMouseMove then
                local screenPos = Camera:WorldToViewportPoint(finalTargetPos)
                local mPos = UserInputService:GetMouseLocation()
                mousemoverel((screenPos.X - mPos.X) * AimSmoothness, (screenPos.Y - mPos.Y) * AimSmoothness)
            end
        end
    else
        LockedTarget = nil
    end
end)

